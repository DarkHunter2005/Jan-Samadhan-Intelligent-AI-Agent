# Backend configuration (copy to .env and adjust)
PORT=4000
NODE_ENV=development

# REQUIRED in production - use a long random string
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY=12h

# SQLite file. Swap src/db/index.js to move to Postgres/Mongo.
DB_FILE=./data/grievance.db

# Python ML service
ML_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=6000
ML_RETRIES=2
DUP_CANDIDATES=40

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Background SLA escalation sweep (ms); 0 disables
ESCALATION_INTERVAL_MS=60000

# Rate limits (raise SUBMIT_RATE_LIMIT when running the e2e suite)
SUBMIT_RATE_LIMIT=20
READ_RATE_LIMIT=300
AUTH_RATE_LIMIT=50
